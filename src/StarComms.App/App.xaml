<Application ThemeMode="Dark" x:Class="StarComms.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <PathGeometry x:Key="IconShip" Figures="M12,2 L21,21 12,17 3,21 Z M12,8 V17"/>
  <PathGeometry x:Key="IconCaptain" Figures="M3,12 L12,5 21,12 M3,18 L12,11 21,18"/>
  <PathGeometry x:Key="IconInvite" Figures="M2,5 H22 V19 H2 Z M3,6 L12,13 21,6"/>
  <PathGeometry x:Key="IconSound" Figures="M3,9 H7 L12,5 V19 L7,15 H3 Z M16,8 Q20,12 16,16 M19,4 Q26,12 19,20"/>
  <PathGeometry x:Key="IconAdd" Figures="M12,3 V21 M3,12 H21"/>
  <PathGeometry x:Key="IconJoin" Figures="M13,3 H21 V21 H13 M2,12 H16 M10,6 L16,12 10,18"/>
  <PathGeometry x:Key="IconFleet" Figures="M8,2 H16 V7 H8 Z M12,7 V12 M5,16 V12 H19 V16 M2,16 H8 V21 H2 Z M16,16 H22 V21 H16 Z"/>
  <Style x:Key="LineIcon" TargetType="Path">
    <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/>
    <Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="Stroke" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <DataTemplate x:Key="IconLabel">
    <DockPanel>
      <Path Style="{StaticResource LineIcon}" Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=Button}}"/>
      <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0"/>
    </DockPanel>
  </DataTemplate>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="AppWindow" TargetType="Window"><Setter Property="Background" Value="#17191D"/><Setter Property="Foreground" Value="#F4F5F6"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#30343B"/><Setter Property="Foreground" Value="#F4F5F6"/><Setter Property="BorderBrush" Value="#606773"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#79D9E1"/><Setter Property="Foreground" Value="#17191D"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="#17191D"/><Setter Property="Foreground" Value="#F4F5F6"/><Setter Property="BorderBrush" Value="#606773"/><Setter Property="Padding" Value="12"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="Background" Value="#22252A"/><Setter Property="Foreground" Value="#F4F5F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#22252A"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="8"/></Style>
 </Application.Resources>
</Application>
