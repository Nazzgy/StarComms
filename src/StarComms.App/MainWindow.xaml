<Window xmlns:local="clr-namespace:StarComms.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="StarComms.App.MainWindow" Style="{StaticResource AppWindow}" Title="StarComms" Width="1100" Height="760" MinWidth="900" MinHeight="650">
  <Window.Resources>
    <local:SpeakingChannelConverter x:Key="SpeakingChannel"/>
    <DataTemplate x:Key="SpeakingMember">
      <WrapPanel x:Name="MicParent">
        <WrapPanel.Tag>
          <MultiBinding Converter="{StaticResource SpeakingChannel}">
            <Binding Path="MemberId"/>
            <Binding Path="DataContext.Speakers" RelativeSource="{RelativeSource AncestorType=Window}"/>
          </MultiBinding>
        </WrapPanel.Tag>
        <TextBlock x:Name="Mic" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
        <TextBlock x:Name="SpeakerName" Text="{Binding Nickname}" FontWeight="SemiBold"/>
        <TextBlock x:Name="ChannelLabel" Margin="5,4,0,4"/>
      </WrapPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tag,ElementName=MicParent}" Value="Ship">
          <Setter TargetName="Mic" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Mic" Property="Foreground" Value="#79D9E1"/>
          <Setter TargetName="SpeakerName" Property="Foreground" Value="#79D9E1"/>
          <Setter TargetName="ChannelLabel" Property="Text" Value="· posádka"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag,ElementName=MicParent}" Value="Command">
          <Setter TargetName="Mic" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Mic" Property="Foreground" Value="#F4C779"/>
          <Setter TargetName="SpeakerName" Property="Foreground" Value="#F4C779"/>
          <Setter TargetName="ChannelLabel" Property="Text" Value="· kapitáni"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#22252A" Padding="24,14">
      <DockPanel>
        <Border Background="#203B40" CornerRadius="8" Padding="7,4" Margin="0,0,10,0">
          <Path Data="M2,10 L2,20 M8,5 L8,25 M14,2 L14,28 M20,6 L20,24 M26,10 L26,20" Stroke="#79D9E1" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="StarComms" FontSize="27" FontWeight="Bold"/>
        <TextBlock Text="{Binding ConnectedFleet}" VerticalAlignment="Center" Foreground="#C1C6CF" FontSize="19" Margin="16,0"/>
        <Button DockPanel.Dock="Right" Content="Zvuk a nastavení" Command="{Binding SettingsCommand}" HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding Status}" Foreground="#C1C6CF" VerticalAlignment="Center" Margin="30,0"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#22252A" Padding="12,6">
      <TextBlock Text="{Binding Version}" HorizontalAlignment="Right" Foreground="#C1C6CF" FontSize="12"/>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#382F22" Padding="16,6" Visibility="{Binding HasMessage,Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding Message}" Foreground="#F4C779"/>
    </Border>
    <Grid>
      <ScrollViewer Visibility="{Binding StartVisible,Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1120">
          <TextBlock Text="Připoj se ke své flotile" FontSize="36" FontWeight="SemiBold"/>
          <TextBlock Text="Stačí přezdívka a pozvánka od kamaráda." Foreground="#C1C6CF" FontSize="19"/>
          <Grid Margin="0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="Tvoje přezdívka"/>
                <TextBox Text="{Binding Nickname,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Tvoje přezdívka"/>
                <TextBlock Text="Adresa nebo pozvánka od hostitele"/>
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Right" Content="Vložit" Command="{Binding PasteCommand}" Margin="8,4,0,12"/>
                  <TextBox Text="{Binding Address,UpdateSourceTrigger=PropertyChanged}" MaxLength="1024" AutomationProperties.Name="Adresa nebo pozvánka od hostitele"/>
                </DockPanel>
                <Button Content="Připojit" Command="{Binding ConnectCommand}" Style="{StaticResource Primary}"/>
                <Button Content="Zrušit připojování" Command="{Binding CancelCommand}" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="Chci založit flotilu" FontSize="24"/>
                <TextBlock Text="Kamarádi se připojí k tvému počítači. Dostupnost z internetu se ověří až s konkrétním hráčem." Foreground="#C1C6CF"/>
                <TextBlock Text="Název flotily"/>
                <TextBox Text="{Binding FleetName}"/>
                <Button Content="Chci hostovat" Command="{Binding HostCommand}"/>
                <TextBlock Text="Hostování není spuštěné." Foreground="#F4C779"/>
                <Expander Header="Podrobnosti připojení" Foreground="#C1C6CF">
                  <TextBlock Text="{Binding NetworkDetails}"/>
                </Expander>
              </StackPanel>
            </Border>
          </Grid>
          <Button Content="O aplikaci a licence" Command="{Binding AboutCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Visibility="{Binding FleetVisible,Converter={StaticResource Visible}}" Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding VersionWarning}" Foreground="#F4C779"/>
          <TextBlock Text="{Binding HostStatus}" Visibility="{Binding IsHost,Converter={StaticResource Visible}}"/>
          <WrapPanel>
            <Button Content="Kopírovat pozvánku" Command="{Binding CopyInvitationCommand}" Visibility="{Binding IsHost,Converter={StaticResource Visible}}"/>
            <Button Content="Podrobnosti připojení" Command="{Binding InvitationCommand}" Visibility="{Binding IsHost,Converter={StaticResource Visible}}"/>
            <Button Content="Správa flotily" Command="{Binding AdminCommand}" Visibility="{Binding IsHost,Converter={StaticResource Visible}}"/>
            <Button Content="Zkusit hlas znovu" Command="{Binding ProbeCommand}" Visibility="{Binding NeedsProbe,Converter={StaticResource Visible}}"/>
            <Button Content="Obnovit spojení" Command="{Binding RetryCommand}" Visibility="{Binding CanRetry,Converter={StaticResource Visible}}"/>
            <Button Content="Odpojit / ukončit hostování" Command="{Binding LeaveCommand}"/>
          </WrapPanel>
          <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Pending}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <WrapPanel>
                  <TextBlock Text="{Binding Nickname}" Margin="12"/>
                  <Button Content="Přijmout" Command="{Binding DataContext.AdmitCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"/>
                  <Button Content="Odmítnout" Command="{Binding DataContext.DenyCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"/>
                </WrapPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Lodě flotily" FontSize="22"/>
            <ListBox ItemsSource="{Binding ShipCards}" SelectedValuePath="ShipId" SelectedValue="{Binding SelectedShipId}" MinHeight="95" MaxHeight="340">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="5">
                    <TextBlock Text="Na palubě" Foreground="#79D9E1" FontSize="12" FontWeight="SemiBold" Visibility="{Binding IsOwnShip,Converter={StaticResource Visible}}"/>
                    <DockPanel>
                      <TextBlock Text="{Binding Count,StringFormat='{}{0} os.'}" DockPanel.Dock="Right" Margin="6,0" Foreground="#C1C6CF"/>
                      <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Model}" Foreground="#C1C6CF"/>
                    <TextBlock Text="{Binding Captain}" Foreground="#C1C6CF"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding EmptyShips}"/>

          </StackPanel>
          <StackPanel Grid.Column="1" Margin="24,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Přestoupit sem" Command="{Binding JoinCommand}" Visibility="{Binding CanBoard,Converter={StaticResource Visible}}"/>
              <TextBlock Text="{Binding SelectedShip.Name}" FontSize="27"/>
            </DockPanel>
            <TextBlock Text="{Binding SelectedShip.Model}" Foreground="#C1C6CF"/>
            <TextBlock Text="{Binding ShipContext}" Foreground="#79D9E1" Margin="0,4,0,12"/>
            <ListBox ItemsSource="{Binding Crew}" SelectedItem="{Binding SelectedMember}" MinHeight="80" MaxHeight="290">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Nickname}"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <WrapPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SpeakingMember}"/>
                    <TextBlock Text="Kapitán" Margin="12,4" Foreground="#F4C779" Visibility="{Binding IsCaptain,Converter={StaticResource Visible}}"/>
                    <TextBlock Text="Hostitel" Margin="8,4" Visibility="{Binding IsHost,Converter={StaticResource Visible}}"/>
                    <TextBlock Text="Obnovuje spojení">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Reconnecting">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </WrapPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Visibility="{Binding MemberSelected,Converter={StaticResource Visible}}">
              <TextBlock Text="Hlasitost vybraného člena (0–200 %)"/>
              <Slider Minimum="0" Maximum="2" Value="{Binding MemberVolume}"/>
            </StackPanel>
            <Button Content="Předat velení vybranému členovi" Command="{Binding TransferCommand}" Visibility="{Binding CanTransfer,Converter={StaticResource Visible}}"/>
          </StackPanel>
          <Border Grid.Column="2" Width="210" Style="{StaticResource Panel}" Padding="12" Visibility="{Binding IsCaptain,Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="Kapitáni" FontSize="23" Foreground="#F4C779"/>
              <TextBlock Text="Soukromý kanál"/>
              <ItemsControl ItemsSource="{Binding Captains}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SpeakingMember}" Margin="4,8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#22252A" CornerRadius="10" Padding="12,6" Margin="0,8,0,0">
          <Border.Resources>
            <Style x:Key="RadioButtonStyle" TargetType="Button">
              <Setter Property="Foreground" Value="#F4F5F6"/>
              <Setter Property="Padding" Value="12,5"/>
              <Setter Property="Margin" Value="0,2,8,2"/>
              <Setter Property="MaxWidth" Value="280"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#38454C"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#F4F5F6"/></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#43535C"/></Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Face" Property="Background" Value="#292D32"/>
                        <Setter TargetName="Face" Property="BorderBrush" Value="#50565F"/>
                        <Setter Property="Foreground" Value="#C6CBD2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Border.Resources>
          <StackPanel>
            <TextBlock Text="{Binding Receiving}" Margin="0,0,0,3">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <DataTrigger Binding="{Binding Receiving}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Identity}" VerticalAlignment="Center" Foreground="#C1C6CF" Margin="8,0,0,0"/>
              <TextBlock Text="{Binding TalkStatus}" Foreground="#79D9E1" Margin="0,2"/>
            </DockPanel>
            <WrapPanel VerticalAlignment="Center">
              <Button x:Name="ShipTalk" Background="#203B40" BorderBrush="#599CA4" Style="{StaticResource RadioButtonStyle}" IsEnabled="{Binding CanTalk}">
                <StackPanel>
                  <TextBlock Text="{Binding CrewDestination}" FontSize="14" FontWeight="SemiBold" Margin="0"/>
                  <TextBlock Text="{Binding ShipKey}" FontSize="12" Margin="0,1,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="CommandTalk" Background="#332B1E" BorderBrush="#A98A51" Style="{StaticResource RadioButtonStyle}" Visibility="{Binding IsCaptain,Converter={StaticResource Visible}}" IsEnabled="{Binding CanCommand}">
                <StackPanel>
                  <TextBlock Text="Mluvit ke kapitánům" FontSize="14" FontWeight="SemiBold" Margin="0"/>
                  <TextBlock Text="{Binding CommandKey}" FontSize="12" Margin="0,1,0,0"/>
                </StackPanel>
              </Button>
              <Button Content="{Binding MicrophoneAction}" Command="{Binding MuteCommand}" Style="{StaticResource RadioButtonStyle}" Background="#30343B" BorderBrush="#606773" MinHeight="35" VerticalAlignment="Center"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>
      <DockPanel Visibility="{Binding SettingsVisible,Converter={StaticResource Visible}}" Margin="20,12" MaxWidth="1240">
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
          <Button DockPanel.Dock="Right" Content="Hotovo" MinWidth="110" Command="{Binding DoneCommand}" Style="{StaticResource Primary}"/>
          <TextBlock Text="Zvuk a nastavení" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Zvuková zařízení" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock Text="Mikrofon"/>
          <ComboBox MinHeight="40" Margin="0,4,0,12" ItemsSource="{Binding Inputs}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding InputId}"/>
          <TextBlock Text="Místní test mikrofonu" FontWeight="SemiBold"/>
          <Grid Height="12" Margin="0,4">
            <ProgressBar Minimum="-65" Maximum="0" Value="{Binding Level,Mode=OneWay}"/>
            <Grid IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding BelowThreshold}"/><ColumnDefinition Width="{Binding AboveThreshold}"/></Grid.ColumnDefinitions>
              <Border Grid.Column="1" Width="2" Background="White" HorizontalAlignment="Left"/>
            </Grid>
          </Grid>
          <TextBlock Text="{Binding PreviewStatus}" Foreground="#79D9E1"/>
          <TextBlock Text="{Binding ThresholdDb,StringFormat='Práh aktivace: {0} dBFS'}"/>
          <Slider Minimum="-60" Maximum="-15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ThresholdDb}" AutomationProperties.Name="Práh hlasové aktivace"/>
          <TextBlock Text="Doleva pro tišší řeč, doprava pro hlučnější okolí." Foreground="#C1C6CF"/>
          <TextBlock Text="{Binding DeviceStatus}" Foreground="#C1C6CF" AutomationProperties.AutomationId="DeviceStatus"/>
          <TextBlock Text="Sluchátka"/>
          <ComboBox MinHeight="40" Margin="0,4,0,12" ItemsSource="{Binding Outputs}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding OutputId}"/>
          <WrapPanel>
            <Button Content="Použít vybraná zařízení" Command="{Binding DevicesCommand}"/>
            <Button Content="Vyzkoušet zvuk" Command="{Binding ToneCommand}"/>
          </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Panel}" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Způsob vysílání" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock Text="Zapnuto: hlasová aktivace. Vypnuto: držení tlačítka (PTT)." />
          <CheckBox Content="Hlasová aktivace pro posádku" IsChecked="{Binding ShipAutomatic}" Margin="4,8"/>
          <Button Content="{Binding ShipBindingLabel}" Command="{Binding BindShipCommand}"/>
          <CheckBox Content="Hlasová aktivace pro kapitány" IsChecked="{Binding CommandAutomatic}" Margin="4,8"/>
          <Button Content="{Binding CommandBindingLabel}" Command="{Binding BindCommandCommand}"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Hlasitost" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock Text="Hlasitost posádky (0–200 %)"/>
          <Slider Minimum="0" Maximum="2" Value="{Binding ShipVolume}"/>
          <StackPanel Visibility="{Binding IsCaptain,Converter={StaticResource Visible}}">
            <TextBlock Text="Hlasitost kapitánů (0–200 %)"/>
            <Slider Minimum="0" Maximum="2" Value="{Binding CommandVolume}"/>
            <CheckBox Margin="4,12" Content="Při hovoru kapitánů ztišit posádku" IsChecked="{Binding Ducking}"/>
          </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Diagnostika" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <CheckBox Margin="4,12" Content="Logs on" IsChecked="{Binding Logs}"/>
          <TextBlock Text="Zapisovat diagnostiku vedle StarComms.exe. Ve výchozím stavu vypnuto." Foreground="#C1C6CF"/>
          <Button Content="Kopírovat diagnostiku" Command="{Binding DiagnosticCommand}"/>
                </StackPanel>
              </Border>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
