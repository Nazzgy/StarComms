<Window x:Class="StarComms.App.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:lang="clr-namespace:StarComms.Core;assembly=StarComms.Core" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource AppWindow}" Title="{x:Static lang:UiText.StarcommsFleetManagement}"
    Width="900" Height="660" MinWidth="680" MinHeight="470" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{x:Static lang:UiText.FleetManagement}" FontSize="28" FontWeight="SemiBold" Margin="4,0,4,12"/>
    <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" HorizontalAlignment="Right" FontSize="12" Foreground="#C1C6CF"/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,2">
      <Button DockPanel.Dock="Right" Content="{x:Static lang:UiText.Close}" IsCancel="True"/>
      <TextBlock x:Name="Feedback" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
    <TabControl>
      <TabItem Header="{x:Static lang:UiText.ShipsAndCrews}">
        <Grid Margin="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="170"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,12,0">
            <Button DockPanel.Dock="Top" Content="{x:Static lang:UiText.AddShip}" Tag="{StaticResource IconAdd}" ContentTemplate="{StaticResource IconLabel}" AutomationProperties.Name="{x:Static lang:UiText.AddShip}" x:Name="NewShip" Click="Create" Style="{StaticResource Primary}"/>
            <ListBox x:Name="Ships" DisplayMemberPath="Name" SelectedValuePath="ShipId" AutomationProperties.Name="{x:Static lang:UiText.FleetShips}" SelectionChanged="ShipChanged"/>
          </DockPanel>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0">
              <TextBlock x:Name="ShipTitle" FontSize="24" FontWeight="SemiBold"/>
              <TextBlock x:Name="ShipInfo" Foreground="#C1C6CF"/>
              <StackPanel x:Name="Details">
                <WrapPanel>
                  <Button Content="{x:Static lang:UiText.EditShip}" Click="Rename"/>
                  <Button Content="{x:Static lang:UiText.RemoveShip}" Click="Delete"/>
                </WrapPanel>
                <TextBlock Text="{x:Static lang:UiText.Crew}" FontSize="20" Margin="4,16,0,4"/>
                <TextBlock x:Name="EmptyCrew" Text="{x:Static lang:UiText.NobodyIsAboardYet}"/>
                <ListBox x:Name="Crew" DisplayMemberPath="Label" SelectedValuePath="Id" MaxHeight="195" AutomationProperties.Name="{x:Static lang:UiText.SelectedShipSCrew}" SelectionChanged="CrewChanged"/>
                <Button x:Name="Promote" Content="{x:Static lang:UiText.AppointCaptain}" Tag="{StaticResource IconCaptain}" ContentTemplate="{StaticResource IconLabel}" AutomationProperties.Name="{x:Static lang:UiText.AppointCaptain}" Click="Appoint"/>
                <TextBlock Text="{x:Static lang:UiText.BringAPlayerAboard}" FontSize="20" Margin="4,16,0,4"/>
                <ComboBox x:Name="Boarding" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="{x:Static lang:UiText.PlayerToMove}" SelectionChanged="BoardingChanged"/>
                <Button x:Name="Board" Content="{x:Static lang:UiText.MoveToThisShip}" Click="Move"/>
                <TextBlock x:Name="NobodyToBoard" Text="{x:Static lang:UiText.AllFleetMembersAreAlreadyAboard}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{x:Static lang:UiText.Players}">
        <DockPanel Margin="14">
          <Button DockPanel.Dock="Bottom" x:Name="RemovePlayer" IsEnabled="False" HorizontalAlignment="Left" Content="{x:Static lang:UiText.RemoveFromFleet}" Click="Kick"/>
          <ListBox x:Name="Players" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="{x:Static lang:UiText.AllPlayers}" SelectionChanged="PlayerChanged"/>
        </DockPanel>
      </TabItem>
      <TabItem Header="{x:Static lang:UiText.ShipTemplate}">
        <StackPanel Margin="18">
          <TextBlock Text="{x:Static lang:UiText.SaveAllShipNamesAndModelsForYour}"/>
          <WrapPanel><Button Content="{x:Static lang:UiText.SaveCurrentShips}" Click="SaveTemplate"/>
            <Button Content="{x:Static lang:UiText.AddShipsFromTemplate}" Click="LoadTemplate"/></WrapPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
