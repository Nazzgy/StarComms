<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><UseSharedCompilation>false</UseSharedCompilation><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version><BuildId Condition="'$(BuildId)' == ''">dev</BuildId><InformationalVersion>$(Version)+$(BuildId)</InformationalVersion><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols></PropertyGroup><Target Name="CheckReleaseVersion" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'"><Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BuildId)', '^\d{8}\.\d{6}$'))" Text="Release requires BuildId yyyyMMdd.HHmmss (UTC)." /></Target></Project>
